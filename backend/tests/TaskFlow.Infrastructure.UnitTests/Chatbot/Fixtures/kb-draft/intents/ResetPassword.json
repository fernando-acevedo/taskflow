{
  "intent": "ResetPassword",
  "description": "Wants to reset or recover the password.",
  "triggers": [
    "forgot",
    "reset"
  ],
  "notTriggers": [
    "wrong password"
  ],
  "confusedWith": [
    "WrongPassword"
  ],
  "utterances": {
    "en": [
      "I forgot my password",
      "how do I reset my password",
      "I want to change my password",
      "send me a password reset",
      "recover my password"
    ],
    "es": [
      "olvidé mi contraseña",
      "cómo restablezco mi contraseña",
      "quiero cambiar mi contraseña",
      "envíenme un restablecimiento de clave",
      "recuperar mi contraseña"
    ]
  },
  "entryStep": "reset.start",
  "steps": {
    "reset.start": {
      "text": {
        "en": "You can reset it from the 'Forgot my password' page. We will send you a link by email.",
        "es": "Puedes restablecerla desde la página 'Olvidé mi contraseña'. Te enviaremos un enlace por correo."
      },
      "quickReplies": [
        {
          "id": "go_reset",
          "label": {
            "en": "Open the page",
            "es": "Abrir la página"
          },
          "next": "close",
          "url": "{forgotPassword}"
        },
        {
          "id": "no_mail",
          "label": {
            "en": "The email does not arrive",
            "es": "El correo no llega"
          },
          "next": "email.spam"
        }
      ],
      "expectsText": false,
      "end": false,
      "outcome": null
    }
  }
}
