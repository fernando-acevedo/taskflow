{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  // Optional. With a Redis connection string the session/membership caches are shared between instances (ADR 0020);
  // required to run more than one instance. Without it each instance caches in memory.
  "ConnectionStrings": {
    "Redis": null
  },
  // Telemetry (ADR 0021) is exported only when one of these is set (as app settings / environment variables):
  //   APPLICATIONINSIGHTS_CONNECTION_STRING  -> Azure Monitor
  //   OTEL_EXPORTER_OTLP_ENDPOINT            -> any OTLP collector
  // With neither, traces carry ids (traceId in errors and logs) but nothing leaves the process.
  // Head sampling of traces, 0..1 (ParentBased(TraceIdRatioBased)). Default 0.25 here: a sample is enough to see the
  // shape of traffic and keeps the exporter cost bounded; Development overrides it with 1.0. Lower it (0.1) under load.
  "Telemetry": {
    "SamplingRatio": 0.25
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedOnStartup": false
  },
  "Auth": {
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 14,
    "InvitationDays": 7,
    "AllowSelfRegistration": true
  },
  "Notifications": {
    "DueSoonEnabled": true,
    "DueSoonHourUtc": 8
  },
  "Outbox": {
    "Enabled": true,
    "PollInterval": "00:00:05",
    "BatchSize": 20,
    "MaxAttempts": 8,
    "BaseDelay": "00:00:10",
    "MaxDelay": "01:00:00",
    "LeaseDuration": "00:02:00",
    "SendTimeout": "00:00:30",
    "RetentionDays": 7,
    "FailedRetentionDays": 14
  },
  "Email": {
    "FrontendUrl": null,
    "FromAddress": null,
    "FromName": "TaskFlow",
    "LogWhenSmtpIsMissing": false,
    "Smtp": {
      "Host": null,
      "Port": 587,
      "Security": "StartTls",
      "Username": null,
      "Password": null
    }
  },
  "ForwardedHeaders": {
    "KnownNetworks": []
  },
  "DataProtection": {
    "KeysPath": null
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10
    },
    // Token buckets per user and tenant (ADR 0022): burst size, and tokens added every ReplenishmentSeconds.
    "User": { "TokenLimit": 300, "TokensPerPeriod": 50, "ReplenishmentSeconds": 10 },
    "Report": { "TokenLimit": 30, "TokensPerPeriod": 5, "ReplenishmentSeconds": 10 },
    "Export": { "TokenLimit": 5, "TokensPerPeriod": 1, "ReplenishmentSeconds": 12 }
  },
  "Demo": {
    "Enabled": false,
    "AllowDataWipe": false,
    "ResetCron": "0 3 * * *",
    "TimeZone": "UTC",
    "CheckIntervalMinutes": 15,
    "Accounts": [
      { "Email": "demo.admin@taskflow.demo", "DisplayName": "Demo Admin", "Role": "Admin", "Password": null },
      { "Email": "demo.member@taskflow.demo", "DisplayName": "Demo Member", "Role": "Member", "Password": null }
    ]
  },
  "Seed": {
    "Admin": {
      "Email": null,
      "Password": null
    }
  },
  "AllowedHosts": "*"
}
