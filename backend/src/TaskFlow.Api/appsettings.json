{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedOnStartup": false
  },
  "Auth": {
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 14,
    "InvitationDays": 7,
    "AllowSelfRegistration": true
  },
  "Notifications": {
    "DueSoonEnabled": true,
    "DueSoonHourUtc": 8
  },
  "Email": {
    "FrontendUrl": null,
    "FromAddress": null,
    "FromName": "TaskFlow",
    "LogWhenSmtpIsMissing": false,
    "Smtp": {
      "Host": null,
      "Port": 587,
      "Security": "StartTls",
      "Username": null,
      "Password": null
    }
  },
  "ForwardedHeaders": {
    "KnownNetworks": []
  },
  "DataProtection": {
    "KeysPath": null
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10
    }
  },
  "Demo": {
    "Enabled": false,
    "AllowDataWipe": false,
    "ResetCron": "0 3 * * *",
    "TimeZone": "UTC",
    "CheckIntervalMinutes": 15,
    "Accounts": [
      { "Email": "demo.admin@taskflow.demo", "DisplayName": "Demo Admin", "Role": "Admin", "Password": null },
      { "Email": "demo.member@taskflow.demo", "DisplayName": "Demo Member", "Role": "Member", "Password": null }
    ]
  },
  "Seed": {
    "Admin": {
      "Email": null,
      "Password": null
    }
  },
  "AllowedHosts": "*"
}
