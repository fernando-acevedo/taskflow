{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedOnStartup": false
  },
  "Auth": {
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 14
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10
    }
  },
  "Seed": {
    "Admin": {
      "Email": null,
      "Password": null
    }
  },
  "AllowedHosts": "*"
}
