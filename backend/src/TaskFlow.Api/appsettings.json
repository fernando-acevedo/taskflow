{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedOnStartup": false
  },
  "Auth": {
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 14,
    "InvitationDays": 7,
    "AllowSelfRegistration": true
  },
  "Email": {
    "FrontendUrl": null,
    "FromAddress": null,
    "FromName": "TaskFlow",
    "LogWhenSmtpIsMissing": false,
    "Smtp": {
      "Host": null,
      "Port": 587,
      "Security": "StartTls",
      "Username": null,
      "Password": null
    }
  },
  "ForwardedHeaders": {
    "KnownNetworks": []
  },
  "DataProtection": {
    "KeysPath": null
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10
    }
  },
  "Seed": {
    "Admin": {
      "Email": null,
      "Password": null
    }
  },
  "AllowedHosts": "*"
}
