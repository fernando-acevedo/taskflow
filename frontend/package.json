{
  "name": "taskflow-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "postbuild": "node scripts/apply-csp.mjs && node scripts/apply-csp.mjs --check",
    "check:csp": "node scripts/apply-csp.mjs --check",
    "test:scripts": "node --test scripts/apply-csp.test.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "screenshots": "node scripts/screenshots.mjs",
    "api:types": "node scripts/api-types.mjs",
    "api:check": "node scripts/api-types.mjs --check",
    "e2e": "playwright test",
    "e2e:serve": "node scripts/e2e-serve.mjs"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.3",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@jsverse/transloco": "^8.4.0",
    "@microsoft/applicationinsights-web": "^3.4.6",
    "@microsoft/signalr": "10.0.11",
    "@ngrx/effects": "^22.0.1",
    "@ngrx/entity": "^22.0.1",
    "@ngrx/router-store": "^22.0.1",
    "@ngrx/store": "^22.0.1",
    "@ngrx/store-devtools": "^22.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "angular-eslint": "22.6.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-boundaries": "5.4.0",
    "jsdom": "^30.0.0",
    "openapi-typescript": "7.13.0",
    "playwright": "^1.65.0",
    "prettier": "^3.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
